# Apache config for GoDaddy cPanel hosting.
# Astro builds /skills/index.html etc., which Apache serves at /skills
# automatically. These rules just tidy up URLs and set caching.

Options -MultiViews

# Serve the custom 404 page
ErrorDocument 404 /404.html

# Strip trailing index.html from URLs
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Force HTTPS (safe to keep once your SSL certificate is active)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Cache hashed build assets aggressively, HTML not at all
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
