---
import PageLayout from '../layouts/PageLayout.astro';
import { ongoing, finished } from '../data/books';

// Edit your reading list in src/data/books.ts

const byRecency = [...ongoing].sort(
  (a, b) => new Date(b.lastRead).valueOf() - new Date(a.lastRead).valueOf()
);

const years = [...new Set(finished.map((b) => b.year))].sort((a, b) => b - a);

const longDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

function percent(book: { page?: number; pages?: number }) {
  if (!book.page || !book.pages) return null;
  return Math.min(100, Math.round((book.page / book.pages) * 100));
}
---

<PageLayout
  title="Books"
  intro="Books I have read and Books I am currently reading"
>
  <section>
    <h2>Currently reading</h2>

    <ul class="shelf">
      {
        byRecency.map((book) => {
          const pct = percent(book);
          return (
            <li>
              <div class="ribbon" aria-hidden="true"></div>

              <div class="book">
                <p class="title">{book.title}</p>
                <p class="author muted">{book.author}</p>

                <p class="bookmark">
                  <svg viewBox="0 0 12 16" aria-hidden="true" class="mark">
                    <path d="M1 1h10v14l-5-4-5 4z" fill="currentColor" />
                  </svg>
                  {book.bookmark}
                </p>

                {pct !== null && (
                  <div class="progress">
                    <div
                      class="track"
                      role="progressbar"
                      aria-valuenow={pct}
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-label={`${book.title} reading progress`}
                    >
                      <div class="fill" style={`width:${pct}%`}></div>
                    </div>
                    <span class="pages muted">
                      p. {book.page} of {book.pages} · {pct}%
                    </span>
                  </div>
                )}

                {book.note && <p class="note muted">{book.note}</p>}

                <p class="last">
                  <span class="dot" data-since={book.lastRead} aria-hidden="true"></span>
                  <span class="muted">Last read</span>
                  <time datetime={book.lastRead} data-relative={book.lastRead}>
                    {longDate.format(new Date(book.lastRead))}
                  </time>
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>

    {ongoing.length === 0 && <p class="muted">Nothing on the go right now.</p>}
  </section>

  <hr class="rule" />

  <section>
    <h2>Finished</h2>

    {
      years.map((year) => (
        <div class="year">
          <h3>{year}</h3>
          <ul class="archive">
            {finished
              .filter((b) => b.year === year)
              .map((b) => (
                <li>
                  <span class="a-title">{b.title}</span>
                  <span class="a-author muted">{b.author}</span>
                  {b.note && <span class="a-note muted">{b.note}</span>}
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </section>
</PageLayout>

<style>
  h2 {
    font-weight: 600;
    margin-bottom: 1rem;
  }

  /* ---------- currently reading ---------- */

  .shelf {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .shelf > li {
    position: relative;
    display: flex;
    background: var(--surface);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  /* the bookmark spine down the left edge */
  .ribbon {
    flex: none;
    width: 8px;
    background: var(--accent);
  }

  .book {
    padding: 1.1rem 1.25rem 1.2rem;
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .author {
    font-size: 0.9rem;
    margin: 0.1rem 0 0;
  }

  .bookmark {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.92rem;
    font-weight: 600;
    margin: 0.7rem 0 0;
  }

  .mark {
    width: 11px;
    height: 15px;
    flex: none;
    color: var(--accent);
  }

  .progress {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.7rem;
    max-width: 30rem;
  }

  .track {
    flex: 1;
    height: 5px;
    border-radius: 999px;
    background: var(--surface-line);
    overflow: hidden;
  }

  .fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
  }

  .pages {
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .note {
    font-size: 0.88rem;
    margin: 0.6rem 0 0;
  }

  .last {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    margin: 0.75rem 0 0;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-muted);
    flex: none;
  }

  .dot[data-fresh='recent'] {
    background: var(--accent);
  }

  .dot[data-fresh='stale'] {
    background: var(--warn);
  }

  /* ---------- finished ---------- */

  .year {
    margin-bottom: 1.6rem;
  }

  .year h3 {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    font-size: 0.95rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--surface-line);
    margin-bottom: 0.3rem;
  }

  .archive {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .archive li {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 0.2rem 1.25rem;
    padding: 0.5rem 0;
  }

  .a-title {
    font-weight: 600;
  }

  .a-author {
    font-size: 0.9rem;
  }

  .a-note {
    grid-column: 1 / -1;
    font-size: 0.86rem;
  }

  @media (max-width: 560px) {
    .archive li {
      grid-template-columns: 1fr;
    }
    .progress {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  // "Last read" shown as a relative time, computed in the browser so it
  // stays accurate long after the site was built. The dot warns me when
  // a book has been sitting untouched.
  const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
  const DAY = 86_400_000;

  function daysSince(iso: string) {
    const then = new Date(iso + 'T00:00:00Z').valueOf();
    const today = new Date();
    const utcToday = Date.UTC(today.getFullYear(), today.getMonth(), today.getDate());
    return Math.round((utcToday - then) / DAY);
  }

  document.querySelectorAll<HTMLElement>('[data-relative]').forEach((el) => {
    const days = daysSince(el.dataset.relative!);
    if (days < 0) return;
    el.textContent =
      days === 0
        ? 'today'
        : days < 30
          ? rtf.format(-days, 'day')
          : days < 365
            ? rtf.format(-Math.round(days / 30), 'month')
            : rtf.format(-Math.round(days / 365), 'year');
    el.title = el.dataset.relative!;
  });

  document.querySelectorAll<HTMLElement>('[data-since]').forEach((dot) => {
    const days = daysSince(dot.dataset.since!);
    dot.dataset.fresh = days <= 7 ? 'recent' : days <= 21 ? 'resting' : 'stale';
  });
</script>
