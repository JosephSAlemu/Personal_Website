---
import PageLayout from '../layouts/PageLayout.astro';

// EDIT: one object per publication. Newest first.
const publications = [
  {
    authors: 'Joseph Alemu, Brandon Kong, Paolo Lambre, Kaiwen Kam, Thiruvarangan Ramaraj',
    title: 'Mapping the Medullary Reticular Formation in the Developing Mouse Brain to Uncover Neural Control of Orofacial Behaviors',
    venue: '2026 International Conference on Bioinformatics and Computational Biology',
    year: '2026',
    links: [
      { label: 'PDF', href: 'https://ieeexplore.ieee.org/document/11621652' },
    ],
  },
];
---

<PageLayout
  title="Publications"
  intro="My published papers."
>
  <ol>
    {
      publications.map((pub) => (
        <li>
          <p class="authors muted">{pub.authors}</p>
          <p class="title">{pub.title}</p>
          <p class="venue muted">
            {pub.venue}, {pub.year}
          </p>
          {pub.links.length > 0 && (
            <p class="links">
              {pub.links.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</PageLayout>

<style>
  ol {
    list-style: none;
    counter-reset: pub;
    margin: 0;
    padding: 0;
  }

  li {
    counter-increment: pub;
    position: relative;
    padding: 0 0 1.4rem 2.4rem;
    margin-bottom: 1.4rem;
    border-bottom: 1px solid var(--surface-line);
  }

  li:last-child {
    border-bottom: 0;
    margin-bottom: 0;
  }

  li::before {
    content: '[' counter(pub) ']';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent-link);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 0.95rem;
  }

  p {
    margin: 0;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin: 0.15rem 0;
  }

  .authors,
  .venue {
    font-size: 0.92rem;
  }

  .links {
    display: flex;
    gap: 0.9rem;
    margin-top: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
