---
// The "Languages / Tools / Skills" rows under an entry.
// Variant 'fill' is the primary fact, 'line' sits one level down.
export type Row = {
  label: string;
  items: string[];
  variant?: 'fill' | 'line';
};

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
const visible = rows.filter((r) => r.items.length > 0);
---

{
  visible.map((row) => (
    <div class="stack">
      <span class="stack-label muted">{row.label}</span>
      <ul>
        {row.items.map((item) => (
          <li class={row.variant ?? 'line'}>{item}</li>
        ))}
      </ul>
    </div>
  ))
}

<style>
  .stack {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    margin-top: 0.7rem;
  }

  .stack-label {
    font-size: 0.8rem;
    line-height: 1.5;
    padding-top: 0.1rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: var(--radius-pill);
    padding: 0.12rem 0.65rem;
    line-height: 1.55;
  }

  .fill {
    background: color-mix(in srgb, var(--accent) 24%, transparent);
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .line {
    color: var(--text-muted);
    border: 1px solid var(--surface-line);
  }

  @media (max-width: 520px) {
    .stack {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
