---
import StackRows from './StackRows.astro';
import type { Media } from '../data/projects';

interface Props {
  title: string;
  date?: string;
  meta?: string;
  href?: string;
  tools?: string[];
  skills?: string[];
  media?: Media[];
  /** How large the media runs. Defaults to 'medium'. */
  size?: 'small' | 'medium' | 'large';
}

const {
  title,
  date,
  meta,
  href,
  tools = [],
  skills = [],
  media = [],
  size = 'medium',
} = Astro.props;
---

<article class="entry">
  <div class="head">
    <h3>
      {
        href ? (
          <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    {date && <span class="date muted">{date}</span>}
  </div>

  {meta && <p class="meta muted">{meta}</p>}

  {
    media.length > 0 && (
      <div class="gallery" data-count={Math.min(media.length, 3)} data-size={size}>
        {media.map((m) =>
          m.type === 'video' ? (
            <video
              src={m.src}
              poster={m.poster}
              controls
              muted
              loop
              playsinline
              preload="metadata"
              aria-label={m.alt}
            />
          ) : (
            <a href={m.src} target="_blank" rel="noopener" aria-label={`${m.alt} — open full size`}>
              <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
            </a>
          )
        )}
      </div>
    )
  }

  <div class="body"><slot /></div>

  <StackRows
    rows={[
      { label: 'Tools', items: tools, variant: 'fill' },
      { label: 'Skills', items: skills, variant: 'line' },
    ]}
  />
</article>

<style>
  .entry {
    padding: 1.1rem 0 1.6rem;
    border-bottom: 1px solid var(--surface-line);
  }

  .head {
    display: flex;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
  }

  .date {
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .meta {
    font-size: 0.92rem;
    margin: 0.15rem 0 0;
  }

  /* Media is the content here, so it gets room — but not the whole column.
     Change --media-max to resize every piece at once. */
  .gallery {
    --media-max: 440px;
    display: grid;
    gap: 0.6rem;
    margin: 0.9rem 0 0.2rem;
    max-width: var(--media-max);
  }

  .gallery[data-size='small'] {
    --media-max: 300px;
  }

  .gallery[data-size='large'] {
    --media-max: 100%;
  }

  /* Two or more pieces form a grid, so they need a shared shape. */
  .gallery[data-count='2'],
  .gallery[data-count='3'] {
    --media-max: 100%;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .gallery img,
  .gallery video {
    width: 100%;
    height: auto;
    border-radius: 14px;
    background: var(--surface);
  }

  /* A lone image keeps its own proportions, so nothing gets cropped.
     Only the grid forces a uniform ratio, because mismatched tiles
     look broken. */
  .gallery[data-count='2'] img,
  .gallery[data-count='2'] video,
  .gallery[data-count='3'] img,
  .gallery[data-count='3'] video {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .gallery a {
    display: block;
    border-radius: 14px;
  }

  .gallery a:hover img {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .body :global(p) {
    margin: 0.5rem 0 0;
  }
</style>
