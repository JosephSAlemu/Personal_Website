---
import { nav } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

function isCurrent(href: string) {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header class="masthead">
  <a class="skip" href="#main">Skip to content</a>

  <div class="balance" aria-hidden="true"></div>

  <nav class="pillnav" aria-label="Main">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <button class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">
    <span class="bars" aria-hidden="true"></span>
    <span>Menu</span>
  </button>

  <ThemeToggle />

  <div class="mobile-nav" id="mobile-nav" hidden>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.75rem var(--gutter) 0.5rem;
    background: linear-gradient(var(--bg) 62%, transparent);
  }

  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 0.5rem;
    background: var(--pill-bg);
    color: var(--pill-text);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
  }

  /* Mirrors the theme toggle's width on the opposite side, so the pill
     sits dead centre instead of being pushed left by the toggle. */
  .balance {
    flex: none;
    width: 42px;
  }

  /* --- the pill --- */
  .pillnav {
    background: var(--pill-bg);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    box-shadow: 0 2px 14px rgb(0 0 0 / 0.18);
    margin-top: -0.75rem;
  }

  .pillnav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pillnav li + li {
    border-left: 1px solid var(--pill-divider);
  }

  .pillnav a {
    display: block;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--pill-text);
    padding: 0.85rem clamp(0.75rem, 1.7vw, 1.35rem);
    text-decoration: none;
    /* Square by default: a link fills the pill's full height, so any radius
       of its own would notch the corners on hover. The two end links borrow
       the pill's radius instead, below. */
    border-radius: 0;
  }

  .pillnav li:first-child a {
    border-bottom-left-radius: var(--radius-card);
  }

  .pillnav li:last-child a {
    border-bottom-right-radius: var(--radius-card);
  }

  .pillnav a:hover {
    background: var(--pill-hover);
    text-decoration: none;
  }

  .pillnav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  /* --- mobile --- */
  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    background: var(--pill-bg);
    color: var(--pill-text);
    border: 0;
    border-radius: var(--radius-pill);
    padding: 0.6rem 1rem;
    cursor: pointer;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
  }
  .bars::before,
  .bars::after {
    content: '';
    position: relative;
  }
  .bars::before {
    top: -5px;
  }
  .bars::after {
    top: 3px;
  }

  .mobile-nav {
    position: absolute;
    top: 100%;
    left: var(--gutter);
    right: var(--gutter);
    background: var(--pill-bg);
    border-radius: var(--radius-card);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.3);
    padding: 0.5rem;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav a {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--pill-text);
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
  }

  .mobile-nav a:hover {
    background: var(--pill-hover);
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .masthead {
      justify-content: space-between;
    }
    .balance {
      display: none;
    }
    .pillnav {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const panel = document.querySelector<HTMLElement>('#mobile-nav');

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>
