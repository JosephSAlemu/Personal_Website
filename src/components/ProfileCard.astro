---
import { profile } from '../site.config';

const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<aside class="card">
  <div class="avatar">
    {
      profile.avatar ? (
        <img src={profile.avatar} alt={profile.name} width="220" height="220" />
      ) : (
        <span aria-hidden="true">{initials}</span>
      )
    }
  </div>
  <p class="name">{profile.name}</p>
  <ul>
    {profile.cardTags.map((t) => <li>{t}</li>)}
  </ul>
</aside>

<style>
  .card {
    background: var(--surface);
    border-radius: var(--radius-card);
    padding: 1.4rem 1.2rem 1.9rem;
    text-align: center;
    position: sticky;
    top: 6rem;
  }

  .avatar {
    width: min(100%, 220px);
    aspect-ratio: 1;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: var(--accent);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar span {
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 700;
    color: var(--accent-ink);
    letter-spacing: 0.02em;
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    max-width: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .card {
      position: static;
      max-width: 320px;
    }
  }
</style>
